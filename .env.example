# =============================================================================
# Ghost Solana — environment variables
# Copy to `.env` for docker-compose, or to package-specific files for local run.
# NEVER commit real keypairs, .env, or funded wallets.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC BUILD-TIME (frontend) — baked into the Next.js bundle at `next build`.
# Safe to expose in the browser. Do not put secrets here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RELAYER_URL=https://ghost-api.arnabbhowmik.in
NEXT_PUBLIC_PROGRAM_ID=69gepJRrDXGgaKExaUHWmDjtLe4LHxTrNiGVzBGoTczR
NEXT_PUBLIC_USDC_MINT=GLfrBSjkzFQZJrWEcWfA9j1yapabGYTwdcNJKAgqWeCt
NEXT_PUBLIC_ENABLE_DEV_WALLET=false

# -----------------------------------------------------------------------------
# RUNTIME (frontend container / `next start`)
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
PORT=3000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# RUNTIME (relayer) — includes secrets. Host-only.
# -----------------------------------------------------------------------------
RELAYER_PORT=3001
# Listen bind is HOST + PORT inside the container (default 0.0.0.0:3001).
# Health: GET /health
ALLOWED_ORIGINS=https://ghost.arnabbhowmik.in,http://localhost:3000,http://127.0.0.1:3000
RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
PROGRAM_ID=69gepJRrDXGgaKExaUHWmDjtLe4LHxTrNiGVzBGoTczR
USDC_MINT=GLfrBSjkzFQZJrWEcWfA9j1yapabGYTwdcNJKAgqWeCt

# Host path to a standard Solana 64-byte JSON array keypair (solana-keygen).
# Mounted read-only at /keys/relayer.json in docker-compose.
# Devnet fee-payer pubkey (secret stays on the host):
#   EWpDhR9kvBtPSwhiGbqarjxsy97nJSE784HjzkQ9Lsxf
RELAYER_KEYPAIR_PATH=./.keys/relayer.json
RELAYER_SECRET_KEY=
DATA_DIR=./relayer/data
ROOT_HISTORY_SIZE=1024
ALLOW_MOCK_PROOF=0
