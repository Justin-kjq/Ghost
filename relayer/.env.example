# RUNTIME — relayer process. Never bake these into the frontend.
PORT=3001
HOST=0.0.0.0

# Comma-separated browser origins. Default includes the production UI.
ALLOWED_ORIGINS=https://ghost.arnabbhowmik.in,http://localhost:3000,http://127.0.0.1:3000

RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
PROGRAM_ID=69gepJRrDXGgaKExaUHWmDjtLe4LHxTrNiGVzBGoTczR
USDC_MINT=GLfrBSjkzFQZJrWEcWfA9j1yapabGYTwdcNJKAgqWeCt

# Preferred: path to a solana-keygen 64-byte JSON array file on the host.
# The host generates this key; do not bake a key into the image.
RELAYER_KEYPAIR_PATH=/keys/relayer.json
# Optional fallback (JSON array string or bs58). Leave empty on the host.
RELAYER_SECRET_KEY=

# Optional cache dir. Merkle tree is rebuilt from on-chain LeafRecords on boot.
DATA_DIR=/data
ROOT_HISTORY_SIZE=1024

# Only honored when RPC_URL is localhost. Never enable on Devnet/testnet.
ALLOW_MOCK_PROOF=0
