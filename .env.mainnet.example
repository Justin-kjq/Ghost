# =============================================================================
# Ghost Solana — MAINNET (Gas-first)
# Copy values into the host `.env` used by docker-compose on the production box.
# NEVER commit the real `.env` or keypairs.
#
# Launch order:
#  1. Create a dedicated mainnet relayer key (do not reuse a hot demo key if avoidable)
#       solana-keygen new --outfile .keys/relayer-mainnet.json --no-bip39-passphrase
#  2. Fund that pubkey with SOL (feePayer) — start with ~0.5–2 SOL
#  3. Set a paid RPC (Helius / QuickNode / Triton). Public RPC will rate-limit.
#  4. Fill this file → `.env` on the host
#  5. npm run mainnet:preflight
#  6. docker compose build --no-cache && docker compose up -d
#  7. Confirm Reown dashboard allowlists https://ghost.arnabbhowmik.in
#  8. Smoke: /app/credits top-up → /app/send with gas note
#
# Shield (deposit/withdraw) stays OFF until the pool program is on mainnet.
# =============================================================================

# --- Frontend (build-time; requires rebuild) ---
NEXT_PUBLIC_RPC_URL=https://YOUR_MAINNET_RPC_URL
NEXT_PUBLIC_CLUSTER=mainnet-beta
NEXT_PUBLIC_RELAYER_URL=https://ghost-api.arnabbhowmik.in
NEXT_PUBLIC_PROGRAM_ID=69gepJRrDXGgaKExaUHWmDjtLe4LHxTrNiGVzBGoTczR
# Circle USDC (Solana)
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_ENABLE_DEV_WALLET=false
NEXT_PUBLIC_SHIELD_ENABLED=false
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=https://ghost.arnabbhowmik.in

FRONTEND_PORT=3000
PORT=3000
HOST=0.0.0.0

# --- Relayer (runtime) ---
RELAYER_PORT=3001
ALLOWED_ORIGINS=https://ghost.arnabbhowmik.in
RPC_URL=https://YOUR_MAINNET_RPC_URL
SOLANA_CLUSTER=mainnet-beta
PROGRAM_ID=69gepJRrDXGgaKExaUHWmDjtLe4LHxTrNiGVzBGoTczR
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

RELAYER_KEYPAIR_PATH=./.keys/relayer-mainnet.json
RELAYER_SECRET_KEY=
DATA_DIR=./relayer/data-mainnet
ROOT_HISTORY_SIZE=1024
ALLOW_MOCK_PROOF=0

GAS_ENABLED=1
GAS_MAX_PER_HOUR=30
# Empty = any SPL mint X2 holds. Tighten for production if desired.
GAS_ALLOWED_MINTS=
# 0.01 USDC per sponsored send (6 decimals)
GAS_CREDIT_FEE_RAW=10000
# Optional: leave unset to use relayer's associated USDC ATA (auto-created on first top-up)
# GAS_TREASURY=
